{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "ArithmeticOperator",
      "ArrayDeclaration",
      "ArrowFunction",
      "AssignmentOperator",
      "MethodExpression",
      "ObjectLiteral",
      "Regex",
      "StringLiteral",
      "UpdateOperator"
    ]
  },
  "mutate": ["src/decision-recommendation-validator.ts"],
  "thresholds": {
    "high": 70,
    "low": 60,
    "break": 60
  },
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": ".tmp/mutation-decision-recommendation.json"
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vitest.decision-recommendation-mutation.config.ts"
  }
}
