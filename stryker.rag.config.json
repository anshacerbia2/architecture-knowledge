{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "ArrayDeclaration",
      "ArrowFunction",
      "MethodExpression",
      "ObjectLiteral",
      "Regex",
      "StringLiteral"
    ]
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/rag-request.ts",
    "src/rag-context.ts",
    "src/rag-output-contract.ts",
    "src/rag-provider.ts",
    "src/rag-engine.ts",
    "src/rag-evaluation.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": ".tmp/mutation-rag.json" },
  "concurrency": 2,
  "timeoutMS": 10000,
  "thresholds": { "high": 80, "low": 60, "break": 60 }
}
