{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "ArithmeticOperator",
      "ArrayDeclaration",
      "ArrowFunction",
      "AssignmentOperator",
      "MethodExpression",
      "ObjectLiteral",
      "Regex",
      "StringLiteral",
      "UpdateOperator"
    ]
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/graph-projector.ts", "src/graph-query.ts", "src/graph-artifacts.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": ".tmp/mutation-graph.json"
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
