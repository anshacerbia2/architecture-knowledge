# Loaded by the server only. No VITE_* secrets.
PORT=4310
# Optional: defaults to the workspace repository root.
# KNOWLEDGE_REPO_ROOT=D:/Ansha/architecture-description/architecture-knowledge
RETRIEVAL_DATABASE_MODE=local
DATABASE_URL=postgresql://aks:aks@127.0.0.1:54329/architecture_knowledge
# Default remains fake. Live setup and consent: docs/live-provider-pilot.md.
# ATLAS_PROVIDER_MODE=openai
# ATLAS_LIVE_CONSENT=public-only-usd5
# ATLAS_PUBLIC_MANIFEST=sha256:REVIEWED_MANIFEST_HASH
# OPENAI_API_KEY=SET_LOCALLY_NEVER_COMMIT

# No-credit alternative: docs/openrouter-free-connectors.md.
# ATLAS_PROVIDER_MODE=openrouter-free
# ATLAS_AI_CONNECTOR=oauth
# ATLAS_LIVE_CONSENT=openrouter-public-free-only
# Optional explicit consent to NVIDIA recording public inputs for security/service improvement:
# ATLAS_OPENROUTER_DATA_POLICY=nvidia-public-logging
# ATLAS_PUBLIC_MANIFEST=sha256:REVIEWED_MANIFEST_HASH
# For ATLAS_AI_CONNECTOR=api only:
# OPENROUTER_API_KEY=ROTATED_KEY_SET_LOCALLY

# Local CLI runner: docs/antigravity-cli.md. Uses agy -p and your existing login.
# pnpm app:agy:check sends a small public cloud prompt; no new API key is needed.
# ATLAS_PROVIDER_MODE=antigravity-cli
# ATLAS_AGY_EXECUTABLE=C:/Users/YOUR_USER/AppData/Local/agy/bin/agy.exe
# ATLAS_LIVE_CONSENT=agy-public-cloud-cli-history
# ATLAS_PUBLIC_MANIFEST=sha256:REVIEWED_MANIFEST_HASH
