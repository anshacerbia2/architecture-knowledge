# Copy this file to .env, then replace the entire DATABASE_URL value with the
# pooled Neon connection string from Connect > Connection pooling ON.
PORT=4310
RETRIEVAL_DATABASE_MODE=hosted
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: defaults to the workspace repository root.
# KNOWLEDGE_REPO_ROOT=D:/Ansha/architecture-description/architecture-knowledge
