{
  "name": "architecture-knowledge-system",
  "version": "0.2.0",
  "private": true,
  "description": "Validation kernel for a version-controlled architecture knowledge system.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.11.1",
    "pnpm": "10.23.0"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"schemas/**/*.json\" \".github/**/*.yml\" \"*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"schemas/**/*.json\" \".github/**/*.yml\" \"*.yml\"",
    "validate": "pnpm run typecheck && tsx src/cli.ts validate",
    "validate:schema": "tsx src/cli.ts validate schema",
    "validate:vocabulary": "tsx src/cli.ts validate vocabulary",
    "validate:ids": "tsx src/cli.ts validate ids",
    "validate:sources": "tsx src/cli.ts validate sources",
    "validate:claims": "tsx src/cli.ts validate claims",
    "validate:decision-guides": "tsx src/cli.ts validate decision-guides",
    "validate:claim-grounding": "tsx src/cli.ts validate claims",
    "validate:relationships": "tsx src/cli.ts validate relationships",
    "validate:lifecycle": "tsx src/cli.ts validate lifecycle",
    "validate:markdown": "tsx src/cli.ts validate markdown",
    "validate:links": "tsx src/cli.ts validate links",
    "validate:graph": "tsx src/graph-cli.ts check",
    "report:integrity": "tsx src/cli.ts report write",
    "report:check": "tsx src/cli.ts report check",
    "graph": "tsx src/graph-cli.ts",
    "graph:generate": "tsx src/graph-cli.ts generate",
    "graph:check": "tsx src/graph-cli.ts check",
    "graph:query": "tsx src/graph-cli.ts",
    "retrieval": "tsx src/retrieval-cli.ts",
    "retrieval:db:up": "docker compose -f docker-compose.retrieval.yml up -d --wait",
    "retrieval:db:down": "docker compose -f docker-compose.retrieval.yml down --volumes",
    "retrieval:migrate": "tsx src/retrieval-cli.ts migrate",
    "retrieval:units": "tsx src/retrieval-cli.ts units",
    "retrieval:units:check": "tsx src/retrieval-cli.ts units-check",
    "retrieval:index": "tsx src/retrieval-cli.ts index",
    "retrieval:check": "tsx src/retrieval-cli.ts check",
    "retrieval:query": "tsx src/retrieval-cli.ts query",
    "retrieval:evaluate": "tsx src/retrieval-cli.ts evaluate",
    "retrieval:benchmark": "tsx src/retrieval-cli.ts benchmark",
    "rag": "tsx src/rag-cli.ts",
    "rag:answer": "tsx src/rag-cli.ts answer",
    "rag:context": "tsx src/rag-cli.ts context",
    "rag:evaluate": "tsx src/rag-cli.ts evaluate",
    "test": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:mutation": "stryker run",
    "test:mutation:graph": "stryker run stryker.graph.config.json",
    "test:mutation:retrieval": "stryker run stryker.retrieval.config.json",
    "test:mutation:rag": "stryker run stryker.rag.config.json",
    "test:mutation:decision-guides": "stryker run stryker.decision-guide.config.json"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pg": "8.16.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.0.16",
    "prettier": "3.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
