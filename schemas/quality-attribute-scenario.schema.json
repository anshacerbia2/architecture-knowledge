{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/quality-attribute-scenario.schema.json",
  "title": "Quality Attribute Scenario",
  "description": "Structured payload for a concept whose primary type is quality-attribute-scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_kind",
    "type",
    "title",
    "quality_attribute_ids",
    "source",
    "stimulus",
    "environment",
    "artifact",
    "response",
    "response_measure",
    "claim_ids",
    "source_ids",
    "status",
    "review",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "_defs.schema.json#/$defs/conceptId"
    },
    "record_kind": {
      "const": "concept"
    },
    "type": {
      "const": "quality-attribute-scenario"
    },
    "title": {
      "$ref": "_defs.schema.json#/$defs/nonEmptyString"
    },
    "quality_attribute_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "_defs.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true
    },
    "source": {
      "$ref": "#/$defs/scenarioElement"
    },
    "stimulus": {
      "$ref": "#/$defs/scenarioElement"
    },
    "environment": {
      "$ref": "#/$defs/scenarioElement"
    },
    "artifact": {
      "$ref": "#/$defs/scenarioElement"
    },
    "response": {
      "$ref": "#/$defs/scenarioElement"
    },
    "response_measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "metric_ids", "acceptance_criteria"],
      "properties": {
        "statement": {
          "$ref": "_defs.schema.json#/$defs/nonEmptyString"
        },
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "_defs.schema.json#/$defs/conceptId"
          },
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "$ref": "_defs.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/sourceId"
      },
      "uniqueItems": true
    },
    "status": {
      "$ref": "_defs.schema.json#/$defs/lifecycleStatus"
    },
    "review": {
      "$ref": "_defs.schema.json#/$defs/review"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "scenarioElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "concept_ids"],
      "properties": {
        "statement": {
          "$ref": "_defs.schema.json#/$defs/nonEmptyString"
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "$ref": "_defs.schema.json#/$defs/conceptId"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
