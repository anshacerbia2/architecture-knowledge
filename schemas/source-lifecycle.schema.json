{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/source-lifecycle.schema.json",
  "title": "Source Lifecycle Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "initial_state", "states", "transitions"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "status": { "const": "proposed" },
    "initial_state": { "$ref": "_defs.schema.json#/$defs/slug" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "terminal", "evidence_eligibility", "replacement_required"],
        "properties": {
          "key": { "$ref": "_defs.schema.json#/$defs/slug" },
          "terminal": { "type": "boolean" },
          "evidence_eligibility": { "enum": ["admitted", "warning", "forbidden"] },
          "replacement_required": { "type": "boolean" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "authority"],
        "properties": {
          "from": { "$ref": "_defs.schema.json#/$defs/slug" },
          "to": { "$ref": "_defs.schema.json#/$defs/slug" },
          "authority": { "enum": ["automation-or-human", "human-only"] }
        }
      }
    }
  }
}
