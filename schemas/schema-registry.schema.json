{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/schema-registry.schema.json",
  "title": "Schema Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mappings", "record_patterns"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "proposed"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "record_patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "format"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["json", "yaml"]
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "extension", "exclude_names", "schema"],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "pattern": "^\\."
        },
        "exclude_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "front_matter": {
          "type": "boolean"
        }
      }
    }
  }
}
