{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/relationship.schema.json",
  "title": "Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_kind",
    "subject",
    "predicate",
    "object",
    "strength",
    "direction",
    "semantic_scope",
    "conditions",
    "evidence",
    "confidence",
    "status",
    "traversal",
    "notes",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "_defs.schema.json#/$defs/relationshipId"
    },
    "record_kind": {
      "const": "relationship"
    },
    "subject": {
      "$ref": "_defs.schema.json#/$defs/recordId"
    },
    "predicate": {
      "enum": [
        "is-a",
        "part-of",
        "instance-of",
        "specializes",
        "generalizes",
        "related-to",
        "depends-on",
        "requires",
        "enables",
        "constrains",
        "conflicts-with",
        "compatible-with",
        "alternative-to",
        "overlaps-with",
        "supports-investigation-of",
        "presents-risk-to",
        "can-occur-in-context-of",
        "supersedes",
        "deprecated-by",
        "addresses",
        "solves",
        "mitigates",
        "introduces",
        "causes",
        "influences",
        "improves",
        "degrades",
        "measured-by",
        "verified-by",
        "implemented-by",
        "documented-by",
        "governed-by",
        "derived-from",
        "supported-by",
        "contradicted-by",
        "applies-when",
        "avoid-when"
      ]
    },
    "object": {
      "$ref": "_defs.schema.json#/$defs/recordId"
    },
    "strength": {
      "enum": ["weak", "moderate", "strong"]
    },
    "direction": {
      "enum": ["directed", "symmetric"]
    },
    "semantic_scope": {
      "enum": ["concept-global", "claim-context-only"]
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/condition"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "_defs.schema.json#/$defs/confidence"
    },
    "status": {
      "$ref": "_defs.schema.json#/$defs/lifecycleStatus"
    },
    "traversal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "rationale"],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "rationale": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            },
            "required": ["eligible"]
          },
          "then": {
            "properties": {
              "rationale": {
                "$ref": "_defs.schema.json#/$defs/nonEmptyString"
              }
            }
          },
          "else": {
            "properties": {
              "rationale": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "notes": {
      "type": ["string", "null"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "predicate": {
            "enum": [
              "related-to",
              "conflicts-with",
              "compatible-with",
              "alternative-to",
              "overlaps-with",
              "contradicted-by"
            ]
          }
        },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "direction": {
            "const": "symmetric"
          }
        }
      },
      "else": {
        "properties": {
          "direction": {
            "const": "directed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": {
            "enum": [
              "part-of",
              "specializes",
              "generalizes",
              "related-to",
              "depends-on",
              "requires",
              "enables",
              "constrains",
              "conflicts-with",
              "compatible-with",
              "alternative-to",
              "overlaps-with",
              "supports-investigation-of",
              "presents-risk-to",
              "can-occur-in-context-of",
              "supersedes",
              "deprecated-by",
              "addresses",
              "solves",
              "mitigates",
              "introduces",
              "causes",
              "influences",
              "improves",
              "degrades",
              "measured-by",
              "verified-by",
              "implemented-by",
              "governed-by",
              "derived-from",
              "supported-by",
              "contradicted-by",
              "applies-when",
              "avoid-when"
            ]
          }
        },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": {
            "enum": [
              "supersedes",
              "deprecated-by",
              "documented-by",
              "derived-from",
              "supported-by",
              "contradicted-by"
            ]
          }
        },
        "required": ["predicate"]
      },
      "else": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
