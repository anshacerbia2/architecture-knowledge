{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/decision-guide.schema.json",
  "title": "Architecture Decision Guide",
  "description": "Reusable governed decision support. It is not a project decision session, recommendation result, or accepted decision artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_kind",
    "title",
    "decision_question",
    "context_variables",
    "constraints",
    "assumptions",
    "quality_attributes",
    "options",
    "evaluation_criteria",
    "tradeoff_matrix",
    "disqualifiers",
    "risk_questions",
    "recommended_when",
    "avoid_when",
    "evolution_triggers",
    "evidence",
    "uncertainty_policy",
    "privacy",
    "authority",
    "status",
    "review",
    "version"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "_defs.schema.json#/$defs/decisionGuideId" },
    "record_kind": { "const": "decision-guide" },
    "title": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
    "decision_question": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
    "context_variables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextVariable" }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/constraintBinding" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumptionBinding" }
    },
    "quality_attributes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/qualityAttributeBinding" }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/option" }
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationCriterion" }
    },
    "tradeoff_matrix": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/tradeoffCell" }
    },
    "disqualifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/optionRule" }
    },
    "risk_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/riskQuestion" }
    },
    "recommended_when": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/optionRule" }
    },
    "avoid_when": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/optionRule" }
    },
    "evolution_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evolutionTrigger" }
    },
    "evidence": { "$ref": "#/$defs/claimIds" },
    "uncertainty_policy": { "$ref": "#/$defs/uncertaintyPolicy" },
    "privacy": { "$ref": "#/$defs/privacyPolicy" },
    "authority": { "$ref": "#/$defs/authorityBoundary" },
    "status": { "$ref": "_defs.schema.json#/$defs/lifecycleStatus" },
    "review": { "$ref": "_defs.schema.json#/$defs/review" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_defs.schema.json#/$defs/claimId" },
      "uniqueItems": true
    },
    "qualifiedCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "scope", "concept_ids"],
      "properties": {
        "statement": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "scope": { "enum": ["edge-local", "reusable-concept"] },
        "concept_ids": {
          "type": "array",
          "items": { "$ref": "_defs.schema.json#/$defs/conceptId" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "scope": { "const": "reusable-concept" } },
            "required": ["scope"]
          },
          "then": { "properties": { "concept_ids": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualifiedCondition" }
    },
    "contextVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "question",
        "description",
        "value_type",
        "required",
        "sensitivity",
        "unit",
        "allowed_values"
      ],
      "properties": {
        "key": { "$ref": "_defs.schema.json#/$defs/slug" },
        "question": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "description": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "value_type": {
          "enum": ["string", "number", "integer", "boolean", "enum", "duration", "data-size"]
        },
        "required": { "type": "boolean" },
        "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
        "unit": { "type": ["string", "null"] },
        "allowed_values": {
          "type": "array",
          "items": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value_type": { "const": "enum" } },
            "required": ["value_type"]
          },
          "then": { "properties": { "allowed_values": { "type": "array", "minItems": 2 } } },
          "else": { "properties": { "allowed_values": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "constraintBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "hardness", "rationale", "conditions", "claim_ids"],
      "properties": {
        "concept_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "hardness": { "enum": ["hard", "preference"] },
        "rationale": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "assumptionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "validation_question", "conditions", "claim_ids"],
      "properties": {
        "concept_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "validation_question": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "qualityAttributeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "priority", "rationale", "conditions", "claim_ids"],
      "properties": {
        "concept_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "priority": { "enum": ["required", "high", "medium", "low"] },
        "rationale": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "label", "summary", "conditions", "claim_ids"],
      "properties": {
        "concept_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "label": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "summary": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "evaluationCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "question",
        "quality_attribute_id",
        "scale",
        "direction",
        "unit",
        "conditions",
        "claim_ids"
      ],
      "properties": {
        "key": { "$ref": "_defs.schema.json#/$defs/slug" },
        "question": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "quality_attribute_id": {
          "oneOf": [{ "$ref": "_defs.schema.json#/$defs/conceptId" }, { "type": "null" }]
        },
        "scale": { "enum": ["qualitative", "ordinal", "quantitative"] },
        "direction": {
          "enum": ["higher-is-better", "lower-is-better", "context-dependent"]
        },
        "unit": { "type": ["string", "null"] },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "scale": { "const": "quantitative" } },
            "required": ["scale"]
          },
          "then": { "properties": { "unit": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "tradeoffCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "criterion", "assessment", "conditions", "claim_ids"],
      "properties": {
        "option_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "criterion": { "$ref": "_defs.schema.json#/$defs/slug" },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating", "rationale", "value", "unit", "uncertainty"],
          "properties": {
            "rating": {
              "enum": ["favorable", "mixed", "unfavorable", "unknown", "not-applicable"]
            },
            "rationale": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
            "value": { "type": ["number", "string", "null"] },
            "unit": { "type": ["string", "null"] },
            "uncertainty": { "enum": ["none", "low", "medium", "high", "unresolved"] }
          }
        },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "optionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "rationale", "conditions", "claim_ids"],
      "properties": {
        "option_id": { "$ref": "_defs.schema.json#/$defs/conceptId" },
        "rationale": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/qualifiedCondition" }
        },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "riskQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "affected_option_ids", "conditions", "claim_ids"],
      "properties": {
        "question": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "affected_option_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "_defs.schema.json#/$defs/conceptId" },
          "uniqueItems": true
        },
        "conditions": { "$ref": "#/$defs/conditions" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "evolutionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "rationale", "affected_option_ids", "claim_ids"],
      "properties": {
        "condition": { "$ref": "#/$defs/qualifiedCondition" },
        "rationale": { "$ref": "_defs.schema.json#/$defs/nonEmptyString" },
        "affected_option_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "_defs.schema.json#/$defs/conceptId" },
          "uniqueItems": true
        },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "uncertaintyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_evidence", "conflicting_evidence", "unknown_context", "tie"],
      "properties": {
        "missing_evidence": { "enum": ["insufficient-evidence", "exclude-assessment"] },
        "conflicting_evidence": { "const": "preserve-conflict-and-escalate" },
        "unknown_context": {
          "enum": ["request-clarification", "present-bounded-scenarios"]
        },
        "tie": { "enum": ["present-equivalent-options", "escalate-human"] }
      }
    },
    "privacyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_context_classifications",
        "external_provider_policy",
        "session_persistence"
      ],
      "properties": {
        "allowed_context_classifications": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["public", "internal", "confidential", "restricted"] },
          "uniqueItems": true
        },
        "external_provider_policy": {
          "enum": ["prohibited", "explicit-session-authorization"]
        },
        "session_persistence": { "const": "ephemeral-only" }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_only",
        "human_decision_required",
        "automation_may_approve",
        "generated_artifact_status"
      ],
      "properties": {
        "recommendation_only": { "const": true },
        "human_decision_required": { "const": true },
        "automation_may_approve": { "const": false },
        "generated_artifact_status": { "const": "draft" }
      }
    }
  }
}
