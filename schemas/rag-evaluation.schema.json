{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/rag-evaluation.schema.json",
  "title": "RAG Evaluation Artifacts",
  "$defs": {
    "goldenBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "notes", "cases"],
      "properties": {
        "version": { "const": 3 },
        "status": { "const": "draft" },
        "notes": { "type": "string", "minLength": 1 },
        "cases": {
          "type": "array",
          "minItems": 20,
          "items": { "$ref": "#/$defs/goldenCase" }
        }
      }
    },
    "goldenCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "question",
        "acceptable_statuses",
        "must_invoke_model",
        "expected_claim_ids",
        "forbidden_claim_ids",
        "expected_epistemic_types",
        "prohibited_output_terms",
        "holdout",
        "filters"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "category": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "acceptable_statuses": { "$ref": "#/$defs/answerStatuses" },
        "must_invoke_model": { "type": "boolean" },
        "expected_claim_ids": { "$ref": "#/$defs/claimIds" },
        "forbidden_claim_ids": { "$ref": "#/$defs/claimIds" },
        "expected_epistemic_types": { "$ref": "#/$defs/epistemicTypes" },
        "prohibited_output_terms": { "$ref": "#/$defs/nonEmptyStrings" },
        "holdout": { "type": "boolean" },
        "filters": { "type": "object" }
      }
    },
    "caseContractRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "notes", "contracts"],
      "properties": {
        "version": { "const": 1 },
        "status": { "const": "draft" },
        "notes": { "type": "string", "minLength": 1 },
        "contracts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/caseContract" }
        }
      }
    },
    "caseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "contract_kind",
        "question_sha256",
        "required_category",
        "acceptable_statuses",
        "must_invoke_model",
        "expected_claim_ids",
        "forbidden_claim_ids",
        "expected_epistemic_types",
        "prohibited_output_terms",
        "holdout"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "contract_kind": { "enum": ["natural-no-answer", "adversarial-safety"] },
        "question_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "required_category": { "type": "string", "minLength": 1 },
        "acceptable_statuses": { "$ref": "#/$defs/answerStatuses" },
        "must_invoke_model": { "type": "boolean" },
        "expected_claim_ids": { "$ref": "#/$defs/claimIds" },
        "forbidden_claim_ids": { "$ref": "#/$defs/claimIds" },
        "expected_epistemic_types": { "$ref": "#/$defs/epistemicTypes" },
        "prohibited_output_terms": { "$ref": "#/$defs/nonEmptyStrings" },
        "holdout": { "type": "boolean" }
      }
    },
    "caseId": { "type": "string", "pattern": "^RAG-[0-9]{3}$" },
    "answerStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["answered", "insufficient-evidence", "refused"] }
    },
    "claimIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^AKL-[0-9]{6}$" }
    },
    "epistemicTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["sourced-claim", "synthesis", "inference", "recommendation", "uncertainty"]
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
