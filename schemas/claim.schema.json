{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-knowledge.local/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_kind",
    "subject",
    "predicate",
    "object",
    "statement",
    "claim_type",
    "semantic_scope",
    "conditions",
    "confidence",
    "sources",
    "derived_from_claims",
    "status",
    "notes",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "_defs.schema.json#/$defs/claimId"
    },
    "record_kind": {
      "const": "claim"
    },
    "subject": {
      "$ref": "_defs.schema.json#/$defs/recordId"
    },
    "predicate": {
      "$ref": "_defs.schema.json#/$defs/slug"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "record_id": {
          "$ref": "_defs.schema.json#/$defs/recordId"
        },
        "literal": {
          "$ref": "_defs.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "statement": {
      "$ref": "_defs.schema.json#/$defs/nonEmptyString"
    },
    "claim_type": {
      "enum": [
        "direct-source-claim",
        "normalized-source-claim",
        "synthesis",
        "inference",
        "recommendation",
        "hypothesis",
        "opinion"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/condition"
      }
    },
    "confidence": {
      "$ref": "_defs.schema.json#/$defs/confidence"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/sourceId"
      },
      "uniqueItems": true
    },
    "derived_from_claims": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/claimId"
      },
      "uniqueItems": true
    },
    "status": {
      "$ref": "_defs.schema.json#/$defs/lifecycleStatus"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "semantic_scope": {
      "enum": ["concept-global", "claim-context-only"]
    },
    "source_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator"],
        "properties": {
          "source_id": {
            "$ref": "_defs.schema.json#/$defs/sourceId"
          },
          "locator": {
            "$ref": "_defs.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force", "applies_to", "exceptions"],
      "properties": {
        "force": {
          "enum": ["must", "must-not", "should", "should-not", "recommended", "may"]
        },
        "applies_to": {
          "$ref": "_defs.schema.json#/$defs/nonEmptyString"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "_defs.schema.json#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "enum": [
              "direct-source-claim",
              "normalized-source-claim",
              "synthesis",
              "inference",
              "recommendation"
            ]
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "sources": {
                "minItems": 1,
                "type": "array"
              }
            }
          },
          {
            "properties": {
              "derived_from_claims": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "enum": ["recommendation", "hypothesis"]
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
